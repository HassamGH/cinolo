# TMDB provides all movie/TV metadata, search, cast, seasons & episodes.
# Get a free API key (v3 auth) at https://www.themoviedb.org/settings/api
# This key stays server-side only — it is read by server/index.ts and
# never shipped to the browser.
TMDB_API_KEY=8a8bf2b2283c4d74f042e4696f9a2399

# Port for the local TMDB proxy server.
PORT=8787

# Vidcore.io is the actual video playback source (native player, keyed by
# TMDB id — no API key required). Override only if Vidcore changes domains.
VITE_VIDCORE_BASE_URL=https://vidcore.io
